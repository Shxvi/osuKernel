;
; osuKernel Ultra-Low Latency Kernel Driver INF
; Target Tablets: Wacom One CTL-472, CTL-672, Intuos CTL-4100, CTL-6100, etc.
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = USB
ClassGuid   = {36fc9e60-c465-11cf-8056-444553540000}
Provider    = %ManufacturerName%
CatalogFile = osuKernel.cat
DriverVer   = 09/20/2026,1.0.0.3
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
osuKernel.sys = 1,,

; ================= Class Installation =================

[Manufacturer]
%ManufacturerName% = Standard,NTamd64.10.0...16299,NTarm64.10.0...16299

[Standard.NTamd64.10.0...16299]
