; ================= Device Installation =================

[osuKernel_Device.NT]
CopyFiles = Drivers_Dir
AddProperty = osuKernel_Device_Properties

[osuKernel_Device.NT.HW]
AddProperty = osuKernel_Device_Properties

[Drivers_Dir]
osuKernel.sys

[osuKernel_Device_Properties]
; DEVPKEY_Device_Model {78c34fc8-104a-4aca-9ea4-524d52996e57}, 39 (DEVPROP_TYPE_STRING = 18)
{78c34fc8-104a-4aca-9ea4-524d52996e57}, 39, 18, , "osuKernel"
; DEVPKEY_DeviceContainer_Category {78c34fc8-104a-4aca-9ea4-524d52996e57}, 90 (DEVPROP_TYPE_STRING_LIST = 0x00002012)
{78c34fc8-104a-4aca-9ea4-524d52996e57}, 90, 0x00002012, , "Input.Digitizer"
; DEVPKEY_DeviceContainer_PrimaryCategory {78c34fc8-104a-4aca-9ea4-524d52996e57}, 97 (DEVPROP_TYPE_STRING = 18)
{78c34fc8-104a-4aca-9ea4-524d52996e57}, 97, 18, , "Input.Digitizer"
; DEVPKEY_DeviceContainer_Icon {78c34fc8-104a-4aca-9ea4-524d52996e57}, 57 (DEVPROP_TYPE_STRING = 18)
{78c34fc8-104a-4aca-9ea4-524d52996e57}, 57, 18, , "%%SystemRoot%%\System32\ddores.dll,-505"
; DEVPKEY_Device_IconPath {a45c254e-df1c-4efd-8020-67d146a850e0}, 4 (DEVPROP_TYPE_STRING = 18)
{a45c254e-df1c-4efd-8020-67d146a850e0}, 4, 18, , "%%SystemRoot%%\System32\ddores.dll,-505"

; ================= Service Installation =================

[osuKernel_Device.NT.Services]
AddService = osuKernel,%SPSVCINST_ASSOCSERVICE%,osuKernel_Service_Inst

[osuKernel_Service_Inst]
DisplayName    = %osuKernel.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\osuKernel.sys

; ================= WDF Section =================

[osuKernel_Device.NT.Wdf]
KmdfService = osuKernel, osuKernel_wdfsect

[osuKernel_wdfsect]
KmdfLibraryVersion = 1.33

; ================= Strings =================

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName       = "osuKernel Project"
DiskName               = "osuKernel Driver Installation Disk"
osuKernel.DeviceDesc   = "osuKernel"
osuKernel.SVCDESC      = "osuKernel Service"
